{
	"schemaVersion": 1,
	"id": "primordia",
	"version": "${version}",
	"name": "Primordia",
	"description": "Procedurally generated, evolving creatures. Genomes grow skeletons, skeletons grow SDF bodies, bodies walk with IK, and populations evolve and reshape the world.",
	"authors": [
		"jsz"
	],
	"icon": "assets/primordia/icon.png",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.jsz.primordia.Primordia"
		],
		"client": [
			"dev.jsz.primordia.PrimordiaClient"
		],
		"modmenu": [
			"dev.jsz.primordia.client.config.PrimordiaModMenu"
		]
	},
	"accessWidener": "primordia.accesswidener",
  "mixins": [
		"primordia.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
